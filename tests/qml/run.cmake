file(REMOVE_RECURSE "${BINARY_DIR}/qml-tests")
set(module "${BINARY_DIR}/qml-tests/Scancore")
file(MAKE_DIRECTORY "${module}")
file(GLOB_RECURSE components "${SOURCE_DIR}/src/qml/*.qml")
set(directory "module Scancore\n")
foreach(component IN LISTS components)
    get_filename_component(name "${component}" NAME_WE)
    file(COPY "${component}" DESTINATION "${module}")
    file(READ "${component}" content)
    # The standalone runner has no application resource bundle.
    if(name STREQUAL "Shadow")
        file(TO_CMAKE_PATH "${SOURCE_DIR}/resources/branding/shadow.png" shadow)
        string(REPLACE "qrc:/branding/shadow.png" "file:///${shadow}" content "${content}")
        file(WRITE "${module}/Shadow.qml" "${content}")
    endif()
    if(content MATCHES "pragma Singleton")
        string(APPEND directory "singleton ${name} 1.0 ${name}.qml\n")
    else()
        string(APPEND directory "${name} 1.0 ${name}.qml\n")
    endif()
endforeach()
file(GLOB services "${SOURCE_DIR}/tests/qml/Scancore/*.qml")
foreach(service IN LISTS services)
    get_filename_component(name "${service}" NAME_WE)
    file(COPY "${service}" DESTINATION "${module}")
    if(NOT directory MATCHES "singleton ${name} 1.0")
        string(APPEND directory "singleton ${name} 1.0 ${name}.qml\n")
    endif()
endforeach()
file(WRITE "${module}/qmldir" "${directory}")
execute_process(COMMAND "${QMLTESTRUNNER}" -platform offscreen -import "${BINARY_DIR}/qml-tests" -input "${SOURCE_DIR}/tests/qml" -o "${BINARY_DIR}/qml-tests.txt,txt" WORKING_DIRECTORY "${BINARY_DIR}" RESULT_VARIABLE result)
file(READ "${BINARY_DIR}/qml-tests.txt" output)
message("${output}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "QML behavior tests failed: ${result}")
endif()
