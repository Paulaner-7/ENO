# Maintainer: Logesh Senthil <logesh@mediumdev.com>
pkgname=scancore
pkgver=1.2.0
pkgrel=1
pkgdesc='Read comics and novels and watch anime in a native Qt app'
arch=('x86_64')
url='https://github.com/medium-gh/scancore'
license=('MIT')
# Qt WebEngine (Arch's has the H.264 codec) is the anime player.
depends=('gcc-libs' 'glibc' 'qt6-base' 'qt6-declarative' 'qt6-imageformats' 'qt6-speech' 'qt6-svg' 'qt6-webengine')
optdepends=(
  'qt6-wayland: native Wayland platform integration'
)
makedepends=('cmake' 'ninja')
source=(
  "scancore-${pkgver}.tar.gz::https://github.com/medium-gh/scancore/archive/refs/tags/v${pkgver}.tar.gz"
  'lexbor-2.7.0.tar.gz::https://github.com/lexbor/lexbor/archive/refs/tags/v2.7.0.tar.gz'
)
sha256sums=(
  '1243f0d9e1106e954bc54230adea7706a5e92fdcdb84e9bb5a176fbf4bce07ee'
  'e2473ade7173f69c56731ba71291d2ba705675ede2bb4423dc939ed70bcb55b5'
)

build() {
  cmake -S "${srcdir}/scancore-${pkgver}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DFETCHCONTENT_SOURCE_DIR_LEXBOR="${srcdir}/lexbor-2.7.0" \
    -DSCANCORE_BUILD_TESTS=OFF \
    -DSCANCORE_WITH_NOVEL_PACK_INSTALLER=OFF
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 "${srcdir}/scancore-${pkgver}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
